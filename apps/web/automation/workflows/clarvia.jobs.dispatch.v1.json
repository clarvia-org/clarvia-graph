    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Extract error info from HTTP error output for the fail_automation_job call.\n// Runs when a topic endpoint (04–07) returns an error via continueErrorOutput.\n\nconst jobId = $('02 Prepare Job Auth').item.json.id;\n\nconst statusCode = $json.statusCode || $json.error?.httpCode || 0;\nconst errorMessage = $json.message\n  || $json.error?.message\n  || 'Internal endpoint returned an error';\n\nconst errorCode = statusCode >= 400 && statusCode < 500\n  ? 'HTTP_' + statusCode + '_CLIENT'\n  : 'HTTP_' + (statusCode || 'UNKNOWN');\n\nreturn {\n  json: {\n    jobId,\n    failureInfo: {\n      errorCode: errorCode.substring(0, 120),\n      errorMessage: errorMessage.substring(0, 2000)\n    }\n  }\n};"
      },
      "id": "d1e2f3a4-0002-4a00-8000-000000000012",
      "name": "10 Prepare Failure Info",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1480, 760]
    },
