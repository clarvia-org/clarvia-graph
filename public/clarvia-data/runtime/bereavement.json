{
  "life_event": "bereavement",
  "conditions": [
    {
      "id": "condition.lu.bereavement.death_occurred_in_lu",
      "title": "Death occurred in Luxembourg",
      "expression_language": "jsonlogic",
      "expression": { "==": [{ "var": "intake_fact.lu.bereavement.jurisdiction_of_death" }, "LU"] },
      "missing_fact_behavior": "unknown"
    },
    {
      "id": "condition.lu.bereavement.deceased_was_lu_insured",
      "title": "Deceased was insured in Luxembourg",
      "expression_language": "jsonlogic",
      "expression": { "==": [{ "var": "intake_fact.lu.bereavement.deceased_pension_jurisdiction" }, "LU"] },
      "missing_fact_behavior": "unknown"
    }
  ],
  "consequences": [
    {
      "id": "consequence.lu.bereavement.declare_death",
      "title": "Obligation to file death declaration",
      "consequence_type": "obligation",
      "jurisdiction": "LU",
      "trigger": {
        "life_event": "bereavement",
        "condition_refs": ["condition.lu.bereavement.death_occurred_in_lu"]
      },
      "task_template_refs": ["task_template.lu.bereavement.file_death_declaration"]
    },
    {
      "id": "consequence.lu.bereavement.claim_survivor_pension",
      "title": "Right to claim survivor pension",
      "consequence_type": "right",
      "jurisdiction": "LU",
      "trigger": {
        "life_event": "bereavement",
        "condition_refs": ["condition.lu.bereavement.deceased_was_lu_insured"]
      },
      "task_template_refs": ["task_template.lu.bereavement.file_cnap_claim"]
    }
  ],
  "task_templates": [
    {
      "id": "task_template.lu.bereavement.file_death_declaration",
      "title": "File death declaration at the commune",
      "action_type": "file_declaration",
      "authority_refs": ["authority.lu.bureau_etat_civil"],
      "deadline_refs": ["deadline.lu.death_declaration_deadline"],
      "evidence_requirements": {
        "sets": [
          {
            "evidence_type_refs": [
              "evidence_type.lu.medical_death_certificate",
              "evidence_type.lu.identity_document_deceased"
            ]
          }
        ]
      },
      "rendering": {
        "checklist_group": "immediate_formalities",
        "urgency": { "score": 95, "label": "urgent" }
      }
    },
    {
      "id": "task_template.lu.bereavement.file_cnap_claim",
      "title": "File survivor pension claim with CNAP",
      "action_type": "file_claim",
      "authority_refs": ["authority.lu.cnap"],
      "deadline_refs": [],
      "evidence_requirements": {
        "sets": [
          {
            "evidence_type_refs": [
              "evidence_type.lu.death_certificate",
              "evidence_type.lu.marriage_certificate"
            ]
          }
        ]
      },
      "rendering": {
        "checklist_group": "money_and_benefits",
        "urgency": { "score": 70, "label": "important" }
      }
    }
  ],
  "authorities": [
    {
      "id": "authority.lu.bureau_etat_civil",
      "name": "Bureau de l'état civil",
      "name_en": "Civil Registry Office"
    },
    {
      "id": "authority.lu.cnap",
      "name": "Caisse nationale d'assurance pension",
      "name_en": "National Pension Insurance Fund"
    }
  ],
  "deadlines": [
    {
      "id": "deadline.lu.death_declaration_deadline",
      "title": "Death declaration deadline",
      "deadline_type": "relative",
      "calculation": {
        "anchor_event": "date_of_death",
        "offset_hours": 24,
        "label": "within 24 hours"
      }
    }
  ],
  "evidence_types": [
    {
      "id": "evidence_type.lu.medical_death_certificate",
      "canonical_name": "Medical death certificate",
      "synonyms": ["certificat médical de décès", "ärztliche Todesbescheinigung"]
    },
    {
      "id": "evidence_type.lu.identity_document_deceased",
      "canonical_name": "Identity document of the deceased",
      "synonyms": ["pièce d'identité du défunt", "Ausweis des Verstorbenen"]
    },
    {
      "id": "evidence_type.lu.death_certificate",
      "canonical_name": "Death certificate",
      "synonyms": ["acte de décès", "Sterbeurkunde"]
    },
    {
      "id": "evidence_type.lu.marriage_certificate",
      "canonical_name": "Marriage certificate",
      "synonyms": ["acte de mariage", "Heiratsurkunde"]
    }
  ]
}
