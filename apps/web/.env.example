# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Cloudflare Turnstile
TURNSTILE_SECRET=

# Base URL
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Donation Engine — PostgreSQL
DATABASE_URL=postgresql://clarvia_app:password@localhost:5432/clarvia?search_path=clarvia,public
DATABASE_URL_MIGRATOR=postgresql://clarvia_migrator:password@localhost:5432/clarvia

# Donation Engine — n8n integration
N8N_WEBHOOK_URL=http://localhost:5678/webhook/clarvia-jobs-dispatch

# Donation Engine — internal auth (n8n-to-website HMAC)
INTERNAL_HMAC_SECRET=
