# Clarvia Lex email service — example environment configuration.
# Copy to `.env` for local development. NEVER put real secrets in this file
# and NEVER commit a populated `.env`.
#
# Secrets (OPENAI_API_KEY, HMAC_SECRET, ...) are provided ONLY through Cloud Run
# Secret Manager references in deployment, never here.

# One of: development | staging | production
ENVIRONMENT=development

# Google Cloud project that hosts all Lex resources.
GCP_PROJECT_ID=fleet-garage-502110-g6

# Phase 1 requires europe-west1. Any other value fails startup.
GCP_REGION=europe-west1

# Delegated mailbox. Hardcoded in production; do not accept from requests.
LEX_MAILBOX=lex@clarvia.org

# Model family name. Intentionally not pinned to a dated snapshot.
OPENAI_MODEL=gpt-5.6-luna

# Prompt and schema identifiers.
PROMPT_VERSION=lex-v1
SCHEMA_VERSION=lex_response_v1

# Local prompt location. Resolved relative to the service directory when relative.
LEX_PROMPT_PATH=runtime-private/prompts/lex-v1.txt
LEX_RESEARCH_PROMPT_PATH=runtime-private/prompts/lex-research-v1.txt
LEX_WRITER_PROMPT_PATH=runtime-private/prompts/lex-writer-v1.txt

# Send path is always one search-enabled call (single_pass).
# two_pass remains only for leftover eval scripts, not for live mail.
LEX_GENERATION_PIPELINE=single_pass
MAX_OUTPUT_TOKENS=12000
# Paid model calls per inbound mail (1 usual; 2 only if the first body failed validation).
MAX_LLM_CALLS_PER_MESSAGE=2
RESEARCH_PROMPT_VERSION=lex-research-v1
WRITER_PROMPT_VERSION=lex-writer-v1
RESEARCH_SCHEMA_VERSION=lex_research_brief_v1
WRITER_SCHEMA_VERSION=lex_written_response_v1

# Operational switches (blueprint 26.6). Both must allow work before the
# poller or the worker does anything.
PROCESSING_MODE=disabled
PROCESSING_ENABLED=false

# Backend adapters: memory (local/tests) | gcp. Production requires gcp.
ADAPTER_BACKEND=memory

# Discovery and worker lease.
POLL_MAX_RESULTS=50
LEASE_DURATION_SECONDS=600

# Cloud Tasks. The target URL and invoker service account are required when
# ADAPTER_BACKEND=gcp.
CLOUD_TASKS_QUEUE=lex-process
CLOUD_TASKS_LOCATION=europe-west1
CLOUD_TASKS_TARGET_URL=
CLOUD_TASKS_INVOKER_SERVICE_ACCOUNT=

# Firestore database ID. The operator must create it in europe-west1.
FIRESTORE_DATABASE=(default)

# Optional shared secret for /internal/* on top of Cloud Run IAM. Leave empty
# locally; in deployment supply it through a Secret Manager reference.
INTERNAL_AUTH_TOKEN=

# HMAC for clarvia.org POST /v1/ask. Separate from INTERNAL_AUTH_TOKEN so a
# leaked website secret cannot poll or process the mailbox. Fail closed if unset.
LEX_WEBSITE_HMAC_SECRET=

# Guardrails.
MAX_VISIBLE_RECIPIENTS=10
MAX_SENDER_REQUESTS_PER_DAY=5
MAX_THREAD_LEX_REPLIES=5
LEX_INCLUDE_THREAD_QUOTE=true
MAX_BODY_CHARS=100000
MAX_THREAD_CHARS=120000

# Log verbosity.
LOG_LEVEL=INFO
