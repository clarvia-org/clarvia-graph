      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Compute HMAC auth headers for the current job's internal API call.\n// Per blueprint §5.3: HMAC-SHA256(secret, timestamp + \".\" + rawBody)\n// Body includes jobId + worker to match merged domain endpoint schemas.\n// Domain endpoints own job completion (§6.4 step 10), so worker is required.\n\nconst crypto = require('crypto');\n\nconst jobId = $json.id;\nconst worker = 'n8n-dispatcher';\nconst timestamp = new Date().toISOString();\nconst body = JSON.stringify({ jobId, worker });\nconst secret = $env.CLARVIA_INTERNAL_HMAC_SECRET;\n\nconst signature = crypto\n  .createHmac('sha256', secret)\n  .update(timestamp + '.' + body)\n  .digest('hex');\n\nreturn {\n  json: {\n    ...$json,\n    auth: {\n      timestamp,\n      signature,\n      body,\n      jobId\n    }\n  }\n};"
      },
      "id": "d1e2f3a4-0002-4a00-8000-000000000004",
      "name": "02 Prepare Job Auth",
