        "operation": "executeQuery",
        "query": "=SELECT clarvia.fail_automation_job(\n  '{{ $json.jobId }}'::uuid,\n  'n8n-dispatcher',\n  '{{ $json.failureInfo.errorCode }}',\n  '{{ $json.failureInfo.errorMessage }}'\n) AS next_state",
        "options": {}
