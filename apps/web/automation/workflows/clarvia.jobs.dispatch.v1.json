        "jsCode": "// Unknown topic — prepare error payload for dead-lettering.\n\nreturn {\n  json: {\n    jobId: $json.id,\n    failureInfo: {\n      errorCode: 'UNKNOWN_TOPIC',\n      errorMessage: 'Topic \"' + ($json.topic || 'undefined') + '\" is not recognised by the dispatcher'\n    }\n  }\n};"
      },
      "id": "d1e2f3a4-0002-4a00-8000-000000000011",
      "name": "09 Dead Letter Unknown Topic",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1200, 900]
